# Copie para .env e ajuste. O arquivo .env nunca deve ir para o GitHub.
# Todas as variáveis são opcionais: sem .env, o sistema sobe com os valores abaixo.

# ---------- Segredo JWT ----------
# Na versão em microsserviços (docker-compose.yml) NÃO há segredo aqui: o contêiner
# segredo-jwt gera um segredo aleatório na primeira subida e o grava no volume
# jwt-segredo, lido pelos três serviços. Para trocar o segredo (e derrubar todos os logins):
#   docker compose down && docker volume rm helpdesk_jwt-segredo && docker compose up
#
# Só a versão monolítica (docker-compose.monolito.yml) lê JWT_SEGREDO deste arquivo.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=

# Tempo de validade do login, em minutos
TOKEN_MINUTOS=60

# 1 = cria usuários, equipamentos e chamados de exemplo (só para aula)
DADOS_EXEMPLO=1
# Senha dos usuários de exemplo (troque se for mostrar o sistema para outras pessoas)
SENHA_EXEMPLO=Helpdesk2026

# 0 = desliga a documentação /docs (recomendado em produção)
DOCS=1

# ---------- Rede interna (só mude se a faixa abaixo já for usada na sua máquina) ----------
# O IP do gateway precisa estar dentro da sub-rede. Os serviços só aceitam
# X-Forwarded-For vindo desse IP.
REDE_INTERNA_SUBREDE=172.30.80.0/24
GATEWAY_IP_INTERNO=172.30.80.10
